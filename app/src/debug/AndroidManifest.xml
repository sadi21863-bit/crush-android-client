<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            The test harness (CrushSmokeTest, FullE2ETest, fault injection) is
            NOT a launcher entry. It used to be, which put a second "Crush Spike"
            icon in the app drawer and exposed a debug surface to anyone holding
            the phone. It stays reachable for development via an explicit intent:

                adb shell am start -n com.crush.mobile/.ui.screens.spike.SpikeActivity

            exported="false" keeps it off other apps' reach entirely.

            Moved here (2026-10-27) from the main manifest together with the
            spike source files in src/debug/java/, so nothing in this file is
            merged into release builds.
        -->
        <activity
            android:name=".ui.screens.spike.SpikeActivity"
            android:exported="false"
            android:label="Crush Spike"
            android:theme="@style/Theme.CrushMobile" />

        <!--
            O11 (2026-11-22): real list composable in its loading state, for the
            device capture. Debug source set only; not reachable from release.
            Exported because this ROM's `am start` (shell uid) is refused on a
            non-exported activity; the screen is static preview UI with no data.
        -->
        <activity
            android:name=".ui.screens.spike.SessionListPreviewActivity"
            android:exported="true"
            android:label="Session list preview"
            android:theme="@style/Theme.CrushMobile" />

        <!--
            V2-7.3 (2026-11-22): the real ui_block/v1 renderer with a host-authored
            document. Debug source set only; static screen, no data, no input.
            Exported for the same ROM reason as the session-list preview above.
        -->
        <activity
            android:name=".ui.screens.spike.UiBlockPreviewActivity"
            android:exported="true"
            android:label="UI block preview"
            android:theme="@style/Theme.CrushMobile" />

        <!--
            V2-8 candidate A (2026-11-22): paste model output, validate and render.
            Debug source set only; static lab, no data, no input beyond the field.
        -->
        <activity
            android:name=".ui.screens.spike.UiBlockLabActivity"
            android:exported="true"
            android:label="UI block lab"
            android:theme="@style/Theme.CrushMobile" />
    </application>
</manifest>
