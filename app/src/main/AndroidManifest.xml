<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".OpenCodeChatApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenCodeChat"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OpenCodeChat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            The test harness (CrushSmokeTest, FullE2ETest, fault injection) is
            NOT a launcher entry. It used to be, which put a second "Crush Spike"
            icon in the app drawer and exposed a debug surface to anyone holding
            the phone. It stays reachable for development via an explicit intent:

                adb shell am start -n com.opencode.chat/.ui.screens.spike.SpikeActivity

            exported="false" keeps it off other apps' reach entirely.
        -->
        <activity
            android:name=".ui.screens.spike.SpikeActivity"
            android:exported="false"
            android:label="Crush Spike"
            android:theme="@style/Theme.OpenCodeChat" />
    </application>
</manifest>
